{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "databases": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "settings": {
      "type": "object",
      "properties": {
        "budget": {
          "type": "object",
          "properties": {
            "forwardReadMs": { "type": ["integer", "null"], "minimum": 0 },
            "forwardWriteMs": { "type": ["integer", "null"], "minimum": 0 },
            "holdMs": { "type": ["integer", "null"], "minimum": 0 },
            "replicationMs": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "reads": {
          "type": "object",
          "properties": {
            "fromReplicas": { "type": ["boolean", "null"] }
          },
          "additionalProperties": false
        },
        "handoff": {
          "type": "object",
          "properties": {
            "rateBytes": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "auth": {
          "type": "object",
          "properties": {
            "maxFailuresPerConnection": { "type": ["integer", "null"], "minimum": 0 },
            "maxFailuresPerSource": { "type": ["integer", "null"], "minimum": 0 },
            "failureWindowSecs": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "tls": {
          "type": "object",
          "properties": {
            "reloadSecs": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "extra": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                { "type": ["integer", "boolean", "string"] },
                { "type": "array", "items": { "type": ["integer", "boolean", "string"] } }
              ]
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
