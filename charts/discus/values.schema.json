{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "probe": {
      "description": "Fields of a Kubernetes probe. The chart sets the handler.",
      "type": "object",
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "databases": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "admin": {
      "type": "object",
      "properties": {
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "probes": {
      "type": "object",
      "properties": {
        "startup": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" }
      },
      "additionalProperties": false
    },
    "authPolicy": {
      "description": "The flag --auth-policy. The template fails with a message when the value is empty.",
      "type": "string",
      "pattern": "^$|^none$|^(any|all):.+$"
    },
    "aclFile": {
      "type": "object",
      "properties": {
        "secretName": { "type": "string" },
        "key": { "type": "string", "pattern": "^[-._a-zA-Z0-9]+$" }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "budget": {
          "type": "object",
          "properties": {
            "forwardReadMs": { "type": ["integer", "null"], "minimum": 0 },
            "forwardWriteMs": { "type": ["integer", "null"], "minimum": 0 },
            "holdMs": { "type": ["integer", "null"], "minimum": 0 },
            "replicationMs": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "replication": {
          "type": "object",
          "properties": {
            "writeAcks": { "type": ["integer", "null"], "minimum": 0 },
            "writeAckTimeout": { "type": ["string", "null"], "enum": ["open", "closed", null] }
          },
          "additionalProperties": false
        },
        "reads": {
          "type": "object",
          "properties": {
            "fromReplicas": { "type": ["boolean", "null"] }
          },
          "additionalProperties": false
        },
        "handoff": {
          "type": "object",
          "properties": {
            "rateBytes": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "auth": {
          "type": "object",
          "properties": {
            "maxFailuresPerConnection": { "type": ["integer", "null"], "minimum": 0 },
            "maxFailuresPerSource": { "type": ["integer", "null"], "minimum": 0 },
            "failureWindowSecs": { "type": ["integer", "null"], "minimum": 0 },
            "timeoutSecs": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "clients": {
          "type": "object",
          "properties": {
            "max": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "tls": {
          "type": "object",
          "properties": {
            "reloadSecs": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "extra": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                { "type": ["integer", "boolean", "string"] },
                { "type": "array", "items": { "type": ["integer", "boolean", "string"] } }
              ]
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
