FROM rust:1-bookworm@sha256:e6f2cff35d0f309acf8433b4f05878ed77092602c5065cc81801177da0bb3a9c AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
ENV RUSTFLAGS="-C target-feature=+crt-static"
RUN cargo build --release --locked -p discus --target x86_64-unknown-linux-gnu --features pyroscope 2>&1 | grep -i "warning: Using\|statically linked\|Finished" ; test -f target/x86_64-unknown-linux-gnu/release/discus
COPY dnstest /dnstest
RUN cd /dnstest && cargo build --release --target x86_64-unknown-linux-gnu 2>&1 | grep -i "warning: Using\|Finished"
RUN mkdir -p /out/etc/ssl/certs && cp /etc/ssl/certs/ca-certificates.crt /out/etc/ssl/certs/
FROM scratch
COPY --from=build /out/ /
COPY --from=build /src/target/x86_64-unknown-linux-gnu/release/discus /discus
COPY --from=build /dnstest/target/x86_64-unknown-linux-gnu/release/dnstest /dnstest
USER 10001
ENTRYPOINT ["/discus"]
